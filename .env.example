# Database
DATABASE_URL="postgresql://user:password@localhost:5432/ninma_hub"
DIRECT_URL="postgresql://user:password@localhost:5432/ninma_hub"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-a-secure-one"

# Admin Credentials (First Time Setup)
ADMIN_EMAIL="admin@ninmahub.com"
ADMIN_PASSWORD="change-this-password"

# Email Configuration (SMTP)
# Para desenvolvimento, deixe vazio para usar modo de teste
# Para produção, configure com seu servidor SMTP
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@ninmahub.com"
CONTACT_EMAIL="contato@ninmahub.com"
